ferravex_scene 1;
# Aqueduct: shared geometry, rigid colliders, pickups, recovery and autopilot.
# Prefab local children follow their checkpoint root automatically.
prefab bridge {
 node root {component platform {size vec3 5 0.6 5;}}
}
prefab checkpoint_flag {
 node root {component checkpoint {}}
 node pole {transform -2 0.6 -1.8 0 0 0 1 1 1 1; component prop {shape text cylinder; size vec3 0.14 2.8 0.14; color rgba 32 57 60 255;}}
 node flag {transform -1.6 1.65 -1.8 0 0 0 1 1 1 1; component prop {shape text box; size vec3 0.95 0.5 0.04; color rgba 62 143 133 255;}}
}
node tuning {component tuning {gravity number -16; radius number 0.55; density number 2; friction number 1; restitution number 0.08; linear_damping number 0.28; angular_damping number 0.22; speed number 4.5; fall_y number -7; gem_radius number 0.95; checkpoint_radius number 1.5; finish_radius number 1.25;}}
node spawn {transform 0 1.05 2 0 0 0 1 1 1 1; component spawn {route ref /way0;}}
node finish {transform -3 0.9 -39 0 0 0 1 1 1 1; component finish {}}
node bridge0 {use bridge; transform 0. 0. 2. 0 0 0 1 1 1 1; component platform {order int 0;size vec3 6. 0.6 6.;}}
node bridge1 {use bridge; transform 0. 0. -5.25 0 0 0 1 1 1 1; component platform {order int 1;size vec3 3.4 0.6 8.5;}}
node bridge2 {use bridge; transform 0. 0. -12. 0 0 0 1 1 1 1; component platform {order int 2;size vec3 5. 0.6 5.;}}
node bridge3 {use bridge; transform 4.9 0. -12. 0 0 0 1 1 1 1; component platform {order int 3;size vec3 4.8 0.6 3.4;}}
node bridge4 {use bridge; transform 10. 0. -12. 0 0 0 1 1 1 1; component platform {order int 4;size vec3 5.4 0.6 5.4;}}
node bridge5 {use bridge; transform 10. 0. -18.6 0 0 0 1 1 1 1; component platform {order int 5;size vec3 3.4 0.6 7.8;}}
node bridge6 {use bridge; transform 10. 0. -25. 0 0 0 1 1 1 1; component platform {order int 6;size vec3 5. 0.6 5.;}}
node bridge7 {use bridge; transform 3.6 0. -25. 0 0 0 1 1 1 1; component platform {order int 7;size vec3 7.8 0.6 3.4;}}
node bridge8 {use bridge; transform -3. 0. -25. 0 0 0 1 1 1 1; component platform {order int 8;size vec3 5.4 0.6 5.4;}}
node bridge9 {use bridge; transform -3. 0. -31.85 0 0 0 1 1 1 1; component platform {order int 9;size vec3 3. 0.6 8.3;}}
node bridge10 {use bridge; transform -3. 0. -39. 0 0 0 1 1 1 1; component platform {order int 10;size vec3 6. 0.6 6.;}}
node pillar0 {transform -1.2 0.95 -3 0 0 0 1 1 1 1; component obstacle {order int 0; radius number 0.38; height number 1.3;}}
node pillar1 {transform 1.2 0.95 -7 0 0 0 1 1 1 1; component obstacle {order int 1; radius number 0.38; height number 1.3;}}
node pillar2 {transform 3 0.95 -13.2 0 0 0 1 1 1 1; component obstacle {order int 2; radius number 0.38; height number 1.3;}}
node pillar3 {transform 7 0.95 -10.8 0 0 0 1 1 1 1; component obstacle {order int 3; radius number 0.38; height number 1.3;}}
node pillar4 {transform 8.8 0.95 -16 0 0 0 1 1 1 1; component obstacle {order int 4; radius number 0.38; height number 1.3;}}
node pillar5 {transform 11.2 0.95 -21 0 0 0 1 1 1 1; component obstacle {order int 5; radius number 0.38; height number 1.3;}}
node pillar6 {transform 6 0.95 -26.2 0 0 0 1 1 1 1; component obstacle {order int 6; radius number 0.38; height number 1.3;}}
node pillar7 {transform 1 0.95 -23.8 0 0 0 1 1 1 1; component obstacle {order int 7; radius number 0.38; height number 1.3;}}
node checkpoint0 {use checkpoint_flag;transform 10 1.05 -12 0 0 0 1 1 1 1;component checkpoint {order int 0;route ref /way4;}}
node checkpoint1 {use checkpoint_flag;transform -3 1.05 -25 0 0 0 1 1 1 1;component checkpoint {order int 1;route ref /way8;}}
node gem0 {transform 0 1 -5 0 0 0 1 1 1 1;component gem {order int 0;}}
node gem1 {transform 5 1 -12 0 0 0 1 1 1 1;component gem {order int 1;}}
node gem2 {transform 10 1 -18 0 0 0 1 1 1 1;component gem {order int 2;}}
node gem3 {transform 4 1 -25 0 0 0 1 1 1 1;component gem {order int 3;}}
node gem4 {transform -3 1 -30 0 0 0 1 1 1 1;component gem {order int 4;}}
node gem5 {transform -3 1 -36 0 0 0 1 1 1 1;component gem {order int 5;}}
node way0 {transform 0 0 -5 0 0 0 1 1 1 1; component waypoint {order int 0;}}
node way1 {transform 0 0 -12 0 0 0 1 1 1 1; component waypoint {order int 1;}}
node way2 {transform 5 0 -12 0 0 0 1 1 1 1; component waypoint {order int 2;}}
node way3 {transform 10 0 -12 0 0 0 1 1 1 1; component waypoint {order int 3;}}
node way4 {transform 10 0 -18 0 0 0 1 1 1 1; component waypoint {order int 4;}}
node way5 {transform 10 0 -25 0 0 0 1 1 1 1; component waypoint {order int 5;}}
node way6 {transform 4 0 -25 0 0 0 1 1 1 1; component waypoint {order int 6;}}
node way7 {transform -3 0 -25 0 0 0 1 1 1 1; component waypoint {order int 7;}}
node way8 {transform -3 0 -30 0 0 0 1 1 1 1; component waypoint {order int 8;}}
node way9 {transform -3 0 -33 0 0 0 1 1 1 1; component waypoint {order int 9;}}
node way10 {transform -3 0 -36 0 0 0 1 1 1 1; component waypoint {order int 10;}}
node way11 {transform -3 0 -39 0 0 0 1 1 1 1; component waypoint {order int 11;}}
node way12 {transform -3 0 -39 0 0 0 1 1 1 1; component waypoint {order int 12;}}
node way13 {transform -3 0 -39 0 0 0 1 1 1 1; component waypoint {order int 13;}}
node way14 {transform -3 0 -39 0 0 0 1 1 1 1; component waypoint {order int 14;}}
