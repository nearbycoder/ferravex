#!/usr/bin/env python3
"""Build this game for the browser into target/web; --serve also hosts it.

    python3 scripts/build-web.py --serve      # build, then play at http://127.0.0.1:8000/
    python3 scripts/build-web.py --profile dev  # faster debug build, no server

Stages Ferravex's first-party browser host next to the Wasm module: no npm,
wasm-bindgen, CDN or deployment.
"""
import argparse
import functools
import http.server
import json
from pathlib import Path
import re
import shutil
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent


def stage_host(engine: Path, output: Path, wasm: Path) -> None:
    """Copy the checkout's host and shared shaders; no CDN or JS packages."""
    shaders = {}
    for module, specs in (
        ("retained-shader.js", (
            ("retained.rs", "VERTEX_BODY", "vertexBody"),
            ("material.rs", "FRAGMENT_BODY", "fragmentBody"),
            ("material.rs", "DEFAULT_VERTEX_HOOK", "defaultVertexHook"),
            ("material.rs", "DEFAULT_FRAGMENT_HOOK", "defaultFragmentHook"),
        )),
        ("effects-shader.js", (
            ("effects.rs", "SPRITE_VERTEX_BODY", "spriteVertexBody"),
            ("effects.rs", "SPRITE_FRAGMENT_BODY", "spriteFragmentBody"),
        )),
        ("post-shader.js", (
            ("post.rs", "POST_VERTEX_BODY", "postVertexBody"),
            ("post.rs", "POST_DOWN_FRAGMENT_BODY", "postDownFragmentBody"),
            ("post.rs", "POST_UP_FRAGMENT_BODY", "postUpFragmentBody"),
            ("post.rs", "POST_COMPOSITE_FRAGMENT_BODY", "postCompositeFragmentBody"),
        )),
    ):
        parts = []
        for filename, constant, export in specs:
            source = (engine / "crates/ferravex-render/src" / filename).read_text(encoding="utf-8")
            match = re.search(r"pub const " + constant + r':\s*&str\s*=\s*r#"(.*?)"#;', source, re.S)
            if match is None:
                raise ValueError(f"missing shared shader {constant} in {filename}; check engine compatibility")
            parts.append(f"export const {export} = {json.dumps(match[1])};")
        shaders[module] = "\n".join(parts) + "\n"
    output.mkdir(parents=True, exist_ok=True)
    # Include dynamically imported tools, the AudioWorklet and their local imports.
    for path in sorted((engine / "web").glob("*.js")):
        shutil.copyfile(path, output / path.name)
    for name, source in shaders.items():
        (output / name).write_text(source, encoding="utf-8")
    for path in sorted((ROOT / "web").iterdir()):
        if path.is_file():
            shutil.copyfile(path, output / path.name)
    shutil.copyfile(wasm, output / wasm.name)


def wasm_target_missing() -> bool:
    """True only when rustc reports a sysroot without the Wasm standard library."""
    try:
        sysroot = subprocess.check_output(["rustc", "--print", "sysroot"], text=True).strip()
    except (OSError, subprocess.CalledProcessError):
        return False  # Let Cargo report the real problem.
    return not (Path(sysroot) / "lib/rustlib/wasm32-unknown-unknown").is_dir()


def serve(directory: Path, port: int) -> None:
    """Serve the staged game on localhost until Ctrl-C."""
    handler = functools.partial(http.server.SimpleHTTPRequestHandler, directory=str(directory))
    with http.server.ThreadingHTTPServer(("127.0.0.1", port), handler) as server:
        print(f"Playing at http://127.0.0.1:{server.server_address[1]}/  (Ctrl-C to stop)", flush=True)
        try:
            server.serve_forever()
        except KeyboardInterrupt:
            pass


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--profile", choices=("dev", "release"), default="release")
    parser.add_argument("--serve", action="store_true", help="serve target/web on localhost after building")
    parser.add_argument("--port", type=int, default=8000, help="port for --serve (default: 8000)")
    args = parser.parse_args(argv)
    try:
        config = json.loads((ROOT / "ferravex.json").read_text(encoding="utf-8"))
        engine = Path(config["engine_root"])
        if not (engine / "web/runtime.js").is_file():
            raise ValueError("engine checkout moved: update ferravex.json and Cargo.toml")
        if wasm_target_missing():
            raise ValueError("the WebAssembly target is not installed; run once:\n"
                             "  rustup target add wasm32-unknown-unknown")
        # argv and an explicit target directory make spaces/quotes in paths safe
        # and keep all build output in this standalone project.
        subprocess.run([
            "cargo", "build", "--manifest-path", str(ROOT / "Cargo.toml"),
            "--target-dir", str(ROOT / "target"), "--lib", "--target", "wasm32-unknown-unknown",
            "--profile", args.profile, "--offline", "--locked", "--jobs", "2",
        ], cwd=ROOT, check=True)
        folder = "debug" if args.profile == "dev" else "release"
        wasm = ROOT / "target/wasm32-unknown-unknown" / folder / (config["package"].replace("-", "_") + ".wasm")
        stage_host(engine, ROOT / "target/web", wasm)
    except subprocess.CalledProcessError as error:
        return error.returncode if error.returncode > 0 else 1
    except (OSError, ValueError, KeyError) as error:
        print(f"build-web: {error}", file=sys.stderr)
        return 1
    if args.serve:
        try:
            serve(ROOT / "target/web", args.port)
        except OSError as error:
            print(f"build-web: cannot serve on port {args.port}: {error}; try --port 8080", file=sys.stderr)
            return 1
        return 0
    print("Built target/web. Play it with:")
    print("  python3 scripts/build-web.py --serve")
    print("or serve target/web with any static file server (WebGL2 required).")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
