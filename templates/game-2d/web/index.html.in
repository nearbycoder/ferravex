<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>@@WINDOW_TITLE_HTML@@ · Ferravex</title>
  <style>
    * { box-sizing: border-box; }
    html, body { margin: 0; height: 100%; background: #0e1623; color: #e4eef2; font: 14px system-ui; }
    body { display: flex; flex-direction: column; }
    nav { min-height: 42px; padding: 6px 12px; display: flex; align-items: center; gap: 12px; }
    nav span { flex: 1; }
    button { font: inherit; color: inherit; border: 1px solid #5bd5d8; background: #141f2f; padding: 4px 12px; cursor: pointer; }
    button:focus-visible, canvas:focus-visible { outline: 2px solid #f7b553; }
    canvas { display: block; width: 100%; flex: 1; min-height: 0; touch-action: none; }
    [role=status] { position: absolute; top: 45%; width: 100%; text-align: center; pointer-events: none; }
  </style>
</head>
<body>
  <nav><span>@@WINDOW_TITLE_HTML@@ · @@DIMENSION@@</span><button type="button" data-controls aria-pressed="false" disabled>Controls (F2)</button></nav>
  <canvas tabindex="0" data-game="@@NAME@@" aria-label="@@WINDOW_TITLE_HTML@@ game: WASD or arrows to move, Enter to start, Escape to pause"></canvas>
  <div role="status">Loading game…</div>
  <script type="module" src="./runtime.js"></script>
</body>
</html>
