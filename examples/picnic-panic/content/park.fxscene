node flowers_0 {transform 18.6 0 3.6 0 0 0 1 1 1 1; component deco {kind text flowers; size vec3 3.2 0.4 1.6;}}
node flowers_1 {transform -24 0 -1.5 0 0 0 1 1 1 1; component deco {kind text flowers; size vec3 1.6 0.4 4.2;}}
