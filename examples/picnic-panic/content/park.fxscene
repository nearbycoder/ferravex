node cap_8 {transform -11 0.3 -13 0 0 0 1 1 1 1; component shiny {}}
node cap_9 {transform 1.5 0.3 25.6 0 0 0 1 1 1 1; component shiny {}}

# --- Trees: oaks for shade, pines for pinecones, birches for elegance.
node oak_0 {use oak; transform -20 0 13 0 0 0 1 1 1 1;}
node oak_1 {use oak; transform -14 0 21 0 0 0 1 1 1 1; override root {component tree {scale number 1.15;}}}
