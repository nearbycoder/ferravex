#!/usr/bin/env python3
"""Build this game and stage Ferravex's first-party browser host in target/web."""
import argparse
import json
from pathlib import Path
import re
import shutil
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent


def stage_host(engine: Path, output: Path, wasm: Path) -> None:
    """Copy the checkout's host and shared shaders; no CDN or JS packages."""
    shaders = {}
    for module, specs in (
        ("retained-shader.js", (
            ("retained.rs", "VERTEX_BODY", "vertexBody"),
            ("material.rs", "FRAGMENT_BODY", "fragmentBody"),
            ("material.rs", "DEFAULT_VERTEX_HOOK", "defaultVertexHook"),
            ("material.rs", "DEFAULT_FRAGMENT_HOOK", "defaultFragmentHook"),
        )),
        ("effects-shader.js", (
            ("effects.rs", "SPRITE_VERTEX_BODY", "spriteVertexBody"),
            ("effects.rs", "SPRITE_FRAGMENT_BODY", "spriteFragmentBody"),
        )),
    ):
        parts = []
        for filename, constant, export in specs:
            source = (engine / "crates/ferravex-render/src" / filename).read_text(encoding="utf-8")
            match = re.search(r"pub const " + constant + r':\s*&str\s*=\s*r#"(.*?)"#;', source, re.S)
            if match is None:
                raise ValueError(f"missing shared shader {constant} in {filename}; check engine compatibility")
            parts.append(f"export const {export} = {json.dumps(match[1])};")
        shaders[module] = "\n".join(parts) + "\n"
    output.mkdir(parents=True, exist_ok=True)
    # Include dynamically imported tools, the AudioWorklet and their local imports.
    for path in sorted((engine / "web").glob("*.js")):
        shutil.copyfile(path, output / path.name)
    for name, source in shaders.items():
        (output / name).write_text(source, encoding="utf-8")
    for path in sorted((ROOT / "web").iterdir()):
        if path.is_file():
            shutil.copyfile(path, output / path.name)
    shutil.copyfile(wasm, output / wasm.name)


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--profile", choices=("dev", "release"), default="release")
    args = parser.parse_args(argv)
    try:
        config = json.loads((ROOT / "ferravex.json").read_text(encoding="utf-8"))
        engine = Path(config["engine_root"])
        if not (engine / "web/runtime.js").is_file():
            raise ValueError("engine checkout moved: update ferravex.json and Cargo.toml")
        # argv and an explicit target directory make spaces/quotes in paths safe
        # and keep all build output in this standalone project.
        subprocess.run([
            "cargo", "build", "--manifest-path", str(ROOT / "Cargo.toml"),
            "--target-dir", str(ROOT / "target"), "--lib", "--target", "wasm32-unknown-unknown",
            "--profile", args.profile, "--offline", "--locked", "--jobs", "2",
        ], cwd=ROOT, check=True)
        folder = "debug" if args.profile == "dev" else "release"
        wasm = ROOT / "target/wasm32-unknown-unknown" / folder / (config["package"].replace("-", "_") + ".wasm")
        stage_host(engine, ROOT / "target/web", wasm)
    except subprocess.CalledProcessError as error:
        return error.returncode if error.returncode > 0 else 1
    except (OSError, ValueError, KeyError) as error:
        print(f"build-web: {error}", file=sys.stderr)
        return 1
    print("Built target/web. Serve from the project directory:")
    print("  python3 -m http.server 8000 --bind 127.0.0.1 --directory target/web")
    print("Open http://127.0.0.1:8000/ (WebGL2 required).")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
