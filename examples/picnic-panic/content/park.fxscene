node cake {transform 7 0.98 -4 0 0 0 1 1 1 1; component prop {kind text cake;}}
node dish_0 {transform 5.2 0.86 -4.3 0 0 0 1 1 1 1; component prop {kind text dish;}}
node dish_1 {transform 6.0 0.86 -3.6 0 0 0 1 1 1 1; component prop {kind text dish;}}
node dish_2 {transform 8.1 0.86 -4.35 0 0 0 1 1 1 1; component prop {kind text dish;}}
node dish_3 {transform 8.9 0.86 -3.7 0 0 0 1 1 1 1; component prop {kind text dish;}}
node teapot {transform 4.6 0.95 -3.9 0 0 0 1 1 1 1; component prop {kind text teapot;}}
node jelly {transform 9.4 0.92 -4.1 0 0 0 1 1 1 1; component prop {kind text jelly;}}
node apple_0 {transform 19.6 0.95 11.7 0 0 0 1 1 1 1; component prop {kind text apple;}}
node apple_1 {transform 19.8 0.95 12.4 0 0 0 1 1 1 1; component prop {kind text apple;}}
node apple_2 {transform 20.8 0.95 12.3 0 0 0 1 1 1 1; component prop {kind text apple;}}

# --- Shiny bottle caps. A raccoon has priorities.
node cap_0 {transform -20 0.3 18 0 0 0 1 1 1 1; component shiny {}}
node cap_1 {transform -9 0.3 14 0 0 0 1 1 1 1; component shiny {}}
node cap_2 {transform -18 0.55 -3.6 0 0 0 1 1 1 1; component shiny {}}
